# Add these in Vercel -> Project -> Settings -> Environment Variables (and in .env.local if you run locally against Supabase).

# REQUIRED. Supabase -> Connect -> "Transaction pooler" connection string (port 6543); replace [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-x.pooler.supabase.com:6543/postgres

# OPTIONAL. If set, creating a new account requires this code (stops strangers signing up on your public URL).
INVITE_CODE=

# OPTIONAL. Signs the login cookies. Defaults to a key derived from DATABASE_URL. Change it to sign everybody out.
SESSION_SECRET=
