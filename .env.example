# Copy to .env.local for local runs against Supabase, and add the same two names in Vercel → Settings → Environment Variables.
# Supabase → Connect → "Transaction pooler" connection string (port 6543); replace [YOUR-PASSWORD]
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-xx-xxxx-x.pooler.supabase.com:6543/postgres
# The one password you type once per device
APP_PASSWORD=choose-a-long-password
